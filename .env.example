PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the server-only Secret key (sb_secret_...) or legacy service_role key.
# Never expose this value in public/app.js or any browser code.
SUPABASE_SECRET_KEY=replace-with-your-server-secret-key
# Legacy alternative, used only when SUPABASE_SECRET_KEY is empty:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=profile-media

# Optional owner account. Auto-creation is skipped when OWNER_PASSWORD is empty.
OWNER_USERNAME=flovifly
OWNER_PASSWORD=

STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
