PORT=3000
NODE_ENV=development

# At least 32 random bytes. JWT_SECRET remains supported for backward compatibility.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-64-random-hex-characters
JWT_SECRET=

# Optional exact public origin, for example https://flovifly.onrender.com
# Render also exposes RENDER_EXTERNAL_URL automatically.
APP_ORIGIN=

# Server-side sessions
SESSION_MAX_AGE_SECONDS=604800
SESSION_IDLE_SECONDS=86400

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the server-only Secret key (sb_secret_...) or legacy service_role key.
# Never expose this value in public/app.js or any browser code.
SUPABASE_SECRET_KEY=replace-with-your-server-secret-key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=profile-media

# Optional owner account. Auto-creation is skipped when OWNER_PASSWORD is empty.
OWNER_USERNAME=flovifly
OWNER_PASSWORD=

# Premium remains self-service only while this beta flag is enabled.
PREMIUM_BETA_ENABLED=true

STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# For coturn REST API / temporary credentials. Do not put a permanent TURN password here.
TURN_URL=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=3600
